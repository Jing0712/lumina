# LUMINA — copy to .env and fill in. .env is git-ignored; never commit real keys.
# Both services read this file from the repo root.

# ---------- MongoDB Atlas (documents, memory, cache, jobs, vectors, GridFS) ----------
# Atlas free tier (M0) is enough for two weeks. A local mongod has no Vector Search:
# see VECTOR_BACKEND below.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lumina

# atlas-vector-search (default) | mongo-cosine-scan (local mongod fallback, /health must say so)
VECTOR_BACKEND=atlas-vector-search

# ---------- LLM ----------
LLM_PROVIDER=anthropic
# Quick answers + the deep planner sit on the latency SLA (TTFT p95 2.5s, plan p95 4s): use a fast model.
LLM_MODEL=claude-haiku-4-5
# Deep synthesis is where a stronger model earns its cost (still under $0.35/answer).
LLM_MODEL_DEEP=claude-sonnet-4-5
# LLM_MODEL_SUBAGENT=claude-haiku-4-5   deep-search subagents' notes model (defaults to LLM_MODEL)
ANTHROPIC_API_KEY=

# ---------- Search (swappable with no code change) ----------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
SEARCH_CACHE_TTL_SECONDS=21600
# Semantic answer cache (quick, web only; time-sensitive questions never use it)
# ANSWER_CACHE=on
# ANSWER_CACHE_MIN_SIMILARITY=0.93
# ANSWER_CACHE_TTL_SECONDS=21600

# ---------- OpenAI (embeddings; needed even when the LLM is Anthropic) ----------
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Deep search: the expensive gear, so the gates live here ----------
# Sub-questions a plan may hold. Fewer than 3 is a quick search with extra steps.
DEEP_SUB_QUESTIONS_MIN=3
DEEP_SUB_QUESTIONS_MAX=6
# Deep searches per X-User-Id per day. Over cap -> 429 {error, resetsAt}, enforced in the
# agent service. A cap you document but do not enforce is not a cap.
DEEP_DAILY_CAP=5

# ---------- Loop caps (the hard caps from AGENTS.md; do not raise to pass a gate) ----------
MAX_TOOL_CALLS=8
MAX_WALL_CLOCK_SEC=90
# Deep gets a wider envelope because it is doing more, not because it is allowed to sprawl.
MAX_TOOL_CALLS_DEEP=24
MAX_WALL_CLOCK_SEC_DEEP=240

# ---------- Ports & wiring ----------
PORT_GATEWAY=8787
PORT_AGENT=8000
AGENT_URL=http://localhost:8000
# Comma-separated origins the gateway accepts. Add your Vercel URL before you deploy.
CORS_ORIGINS=http://localhost:5173
# Asks per user per minute (other routes get 10x). The bench fires ~40 asks at concurrency 4
# from ONE user id, so 30 would 429 it; 120 leaves headroom.
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# ---------- Web (Vite; only VITE_* reaches the browser — never put a key here) ----------
VITE_API_URL=http://localhost:8787

# ---------- Optional tuning (defaults in backend/agent/src/env.ts) ----------
# QUICK_PAGES_PER_SEARCH=3          pages read per quick search
# DEEP_PAGES_PER_SUB_QUESTION=4     pages read per deep sub-question (budget-capped)
# FETCH_TIMEOUT_MS=2500             per-page fetch timeout
# VERIFY_WAIT_MS=900                how long the first token waits for snippet verification
# RAG_TOP_K=6  RAG_RRF_K=60         hybrid retrieval: chunks returned, RRF constant
# AUTO_DOC_MIN_SCORE=0.35           mode=auto: below this best cosine, also search the web
# EMBEDDED_WORKER=true              run the jobs worker inside the agent (false + `npm run worker` to split)
# LLM_PRICE_IN / LLM_PRICE_OUT      USD per 1M tokens, if your rates differ from the built-in table
